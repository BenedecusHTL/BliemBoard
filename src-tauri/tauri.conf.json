{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BliemBoard",
  "version": "1.0.22",
  "identifier": "com.bliemboard.app",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BliemBoard",
        "width": 1120,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
